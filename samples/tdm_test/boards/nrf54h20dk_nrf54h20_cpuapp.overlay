/ {
	aliases {
		i2s-node0 = &tdm130;
	};
};


 &pinctrl {
	tdm130_default_test: tdm130_default_test {
		group1 {
			psels = <NRF_PSEL(TDM_SCK_M, 1, 3)>,
				<NRF_PSEL(TDM_FSYNC_M, 1, 6)>,
				<NRF_PSEL(TDM_SDOUT, 1, 4)>,
				<NRF_PSEL(TDM_SDIN, 1, 5)>;
		};
	};
 };	

/ {
    reserved-memory {
        tdm_dma_ram: memory@2fc00000 {
            compatible = "nordic,owned-memory", "zephyr,memory-region";
            reg = <0x2fc00000 DT_SIZE_K(8)>;
            status = "okay";
            #memory-region-cells = <0>;
            zephyr,memory-region = "DMA_RAM_TDM";
            zephyr,memory-attr = <( DT_MEM_DMA )>;
        };
    };
};

&tdm130 {
	status = "okay";
	pinctrl-0 = <&tdm130_default_test>;
	pinctrl-names = "default";
	memory-regions = <&tdm_dma_ram>;
	//memory-regions = <&cpuapp_dma_region>;
	mck-clock-source = "ACLK";
	sck-clock-source = "ACLK";
	mck-frequency = <12288000>;
};


&audiopll {
	frequency = <NRFS_AUDIOPLL_FREQ_AUDIO_48K>;
	status = "okay";
};
