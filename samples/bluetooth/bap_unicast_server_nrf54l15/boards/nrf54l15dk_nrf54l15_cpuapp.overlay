/ {
	aliases {
		i2s-node0 = &i2s20;
    };
};

&pinctrl {
	i2s20_default: i2s20_default {
		group1 {
			psels =	<NRF_PSEL(I2S_SCK_M, 1, 10)>,
					<NRF_PSEL(I2S_LRCK_M, 1, 12)>,
					<NRF_PSEL(I2S_SDIN, 1, 11)>;
		};
	};

	i2s20_sleep: i2s20_sleep {
		group1 {
			psels = <NRF_PSEL(I2S_SCK_M, 1, 10)>,
					<NRF_PSEL(I2S_LRCK_M, 1, 12)>,
					<NRF_PSEL(I2S_SDIN, 1, 11)>;
			low-power-enable;
		};
	};
};

&i2s20 {
	status = "okay";
	pinctrl-0 = <&i2s20_default>;
	pinctrl-1 = <&i2s20_sleep>;
	pinctrl-names = "default", "sleep";
};